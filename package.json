{
  "name": "dsh-no-enter-sand",
  "version": "1.0.0",
  "description": "Blocks Enter from sending in the DSH composer: Enter becomes a line break, messages leave only from the send button, and the input box says so in gray.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "composer",
    "enter",
    "keyboard",
    "send"
  ],
  "license": "MIT",
  "author": "poker",
  "homepage": "https://github.com/pokereva/dsh-no-enter-sand#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pokereva/dsh-no-enter-sand.git"
  },
  "bugs": {
    "url": "https://github.com/pokereva/dsh-no-enter-sand/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/harness.cjs",
    "check": "node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
